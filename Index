        // Filtrar proyectos por categoría
        function filterProjects(category) {
            const buttons = document.querySelectorAll('.filter-btn');
            buttons.forEach(btn => {
                if (btn.dataset.category === category) {
                    btn.className = "filter-btn active px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all bg-stone-900 text-stone-50 shadow-sm";
                } else {
                    btn.className = "filter-btn px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all bg-stone-200/70 text-stone-700 hover:bg-stone-300/70";
                }
            });
            renderProjects(category);
        }

        // Abrir Modal de Detalles del Proyecto
        function openProjectModal(projectId) {
            const project = projectsData.find(p => p.id === projectId);
            if (!project) return;

            document.getElementById('modal-category').textContent = project.category;
            document.getElementById('modal-code').textContent = project.code;
            document.getElementById('modal-title').textContent = project.title;
            document.getElementById('modal-location-top').innerHTML = `<i data-lucide="map-pin" class="w-4 h-4 text-terracotta-500"></i><span>${project.location}</span>`;
            document.getElementById('modal-year').textContent = project.year;
            document.getElementById('modal-area').textContent = project.area;
            document.getElementById('modal-materials').textContent = project.materials;
            document.getElementById('modal-description').textContent = project.description;

            const mainImg = document.getElementById('modal-main-img');
            mainImg.src = project.images[0];

            // Renderizar miniaturas
            const thumbsContainer = document.getElementById('modal-thumbnails');
            thumbsContainer.innerHTML = project.images.map((imgUrl, idx) => `
                <button onclick="changeModalImage('${imgUrl}')" class="rounded-lg overflow-hidden aspect-[16/10] border-2 ${idx === 0 ? 'border-terracotta-500' : 'border-transparent'} hover:border-terracotta-500 transition-all focus:outline-none">
                    <img src="${imgUrl}" alt="Vista ${idx + 1}" class="w-full h-full object-cover">
                </button>
            `).join('');

            // Configurar botón de WhatsApp específico para el proyecto abierto
            const waBtn = document.getElementById('modal-whatsapp-btn');
            waBtn.onclick = () => {
                const msg = `Hola Arq. Elena, estuve explorando el catálogo de ARQUITEK y me encantó el proyecto "${project.title}" (${project.category} - ${project.area}). Me gustaría cotizar un proyecto con una estética o alcance similar.`;
                quickWhatsApp(msg);
            };

            const modal = document.getElementById('project-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            lucide.createIcons();
        }

        function changeModalImage(imgUrl) {
            document.getElementById('modal-main-img').src = imgUrl;
        }

        function closeProjectModal() {
            const modal = document.getElementById('project-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = 'auto';
        }

        // Cerrar modal haciendo clic fuera del contenedor
        document.getElementById('project-modal').addEventListener('click', (e) => {
            if (e.target.id === 'project-modal') {
                closeProjectModal();
            }
        });

        // Construir el mensaje estructurado para WhatsApp en tiempo real
        function buildStructuredWhatsAppMessage() {
            const name = document.getElementById('client-name').value.trim() || "[Tu Nombre]";
            const location = document.getElementById('project-location').value.trim() || "[Ciudad/Ubicación]";
            const type = document.getElementById('project-type').value;
            const area = document.getElementById('project-area').value;
            const stage = document.getElementById('project-stage').value;
            const scope = document.getElementById('project-budget').value;
            const notes = document.getElementById('project-notes').value.trim();

            let msg = `Hola Arq. Elena Vázquez, te contacto desde el portafolio web de *ARQUITEK*.\n\n`;
            msg += `*SOLICITUD DE DIAGNÓSTICO ARQUITECTÓNICO:*\n`;
            msg += `• *Cliente:* ${name}\n`;
            msg += `• *Ubicación:* ${location}\n`;
            msg += `• *Tipo de Proyecto:* ${type}\n`;
            msg += `• *Superficie Estimada:* ${area}\n`;
            msg += `• *Estado del Predio/Inmueble:* ${stage}\n`;
            msg += `• *Alcance Buscado:* ${scope}`;

            if (notes) {
                msg += `\n• *Visión / Comentarios:* ${notes}`;
            }

            msg += `\n\n¿Qué disponibilidad tienes esta semana para una breve llamada inicial?`;
            return msg;
        }

        function updateWhatsAppPreview() {
            const previewEl = document.getElementById('whatsapp-preview');
            previewEl.textContent = buildStructuredWhatsAppMessage();
        }

        // Manejar el envío del formulario hacia WhatsApp
        function handleWhatsAppSubmit(event) {
            event.preventDefault();
            const message = buildStructuredWhatsAppMessage();
            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/${ARQUITEK_WHATSAPP_NUMBER}?text=${encodedMessage}`;
            showToast("Abriendo WhatsApp con el resumen de tu proyecto...");
            window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
        }

        // Función para los botones de consulta rápida (1 Clic)
        function quickWhatsApp(customText) {
            const encoded = encodeURIComponent(customText);
            const whatsappUrl = `https://wa.me/${ARQUITEK_WHATSAPP_NUMBER}?text=${encoded}`;
            showToast("Conectando con WhatsApp de ARQUITEK...");
            window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
        }

        // Copiar el mensaje de vista previa al portapapeles
        function copyPreviewMessage() {
            const text = buildStructuredWhatsAppMessage();
            const tempInput = document.createElement("textarea");
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);
            showToast("Mensaje copiado al portapapeles");
        }

        // Alternar el widget flotante de WhatsApp
        function toggleFloatingWA() {
            const card = document.getElementById('floating-wa-card');
            card.classList.toggle('hidden');
        }

        // Mostrar notificación tipo Toast
        function showToast(message) {
            const toast = document.getElementById('toast-notification');
            const textEl = document.getElementById('toast-text');
            textEl.textContent = message;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        // Control del menú móvil
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        // Inicialización al cargar la página
        window.addEventListener('DOMContentLoaded', () => {
            renderProjects('Todos');
            updateWhatsAppPreview();
            lucide.createIcons();
        });
