                                    ${project.location}
                                </span>
                                <span class="font-mono">${project.year}</span>
                            </div>
                            <h3 class="font-serif text-2xl font-medium text-stone-900 group-hover:text-terracotta-600 transition-colors">
                                ${project.title}
                            </h3>
