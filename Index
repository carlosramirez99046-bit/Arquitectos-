        // Renderizar catálogo de proyectos
        function renderProjects(category = 'Todos') {
            const grid = document.getElementById('projects-grid');
            const filtered = category === 'Todos' 
                ? projectsData 
                : projectsData.filter(p => p.category === category);

            grid.innerHTML = filtered.map(project => `
                <article class="project-card group bg-white rounded-2xl overflow-hidden border border-stone-200/90 shadow-sm hover:shadow-xl flex flex-col justify-between cursor-pointer" onclick="openProjectModal(${project.id})">
                    <div>
                        <div class="relative aspect-[4/3] overflow-hidden bg-stone-200">
                            <img 
                                src="${project.images[0]}" 
                                alt="${project.title}" 
                                class="project-img w-full h-full object-cover transition-transform duration-700"
                                onerror="this.src='https://placehold.co/600x450/292724/F9F8F6?text=ARQUITEK'"
                            >
                            <div class="absolute top-4 left-4 flex items-center gap-2">
                                <span class="px-3 py-1 rounded-full text-[11px] font-semibold uppercase tracking-wider bg-stone-900/85 text-stone-50 backdrop-blur-md">
                                    ${project.category}
                                </span>
                            </div>
                            <div class="absolute bottom-4 right-4 w-10 h-10 rounded-xl bg-white/90 backdrop-blur-md text-stone-900 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-md">
