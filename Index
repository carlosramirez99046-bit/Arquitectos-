<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARQUITEK | Estudio de Arquitectura & Diseño Espacial</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cormorant Garamond (Editorial/Arquitectónico) & Plus Jakarta Sans (Técnico/Limpio) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        stone: {
                            50: '#F9F8F6',
                            100: '#F2EFE9',
                            200: '#E6E1D6',
                            300: '#D5CBB8',
                            800: '#292724',
                            900: '#181615',
                        },
                        terracotta: {
                            500: '#B85D3B',
                            600: '#9E4B2C',
                        }
                    }
                }
            }
        }
    </script>

    <style>
        /* Estilos personalizados para estética arquitectónica */
        body {
            background-color: #F9F8F6;
            color: #181615;
            overflow-x: hidden;
        }
        
        .arch-grid-bg {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(24, 22, 21, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(24, 22, 21, 0.04) 1px, transparent 1px);
        }

        /* Ocultar barra de scroll en modales pero permitir desplazamiento */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Animación suave para las tarjetas */
        .project-card {
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .project-card:hover {
            transform: translateY(-6px);
        }
        .project-card:hover .project-img {
            transform: scale(1.05);
        }
    </style>
</head>
<body class="font-sans antialiased selection:bg-terracotta-500 selection:text-white arch-grid-bg">

    <!-- BARRA DE NAVEGACIÓN -->
    <header id="navbar" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 bg-stone-50/90 backdrop-blur-md border-b border-stone-200/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <!-- Logo -->
                <a href="#inicio" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 bg-stone-900 text-stone-50 flex items-center justify-center rounded-lg font-serif text-xl tracking-widest group-hover:bg-terracotta-500 transition-colors">
                        A
                    </div>
                    <div class="flex flex-col">
                        <span class="font-serif text-2xl tracking-[0.2em] font-semibold text-stone-900 leading-none">ARQUITEK</span>
                        <span class="text-[10px] tracking-[0.25em] uppercase text-stone-500 mt-1">Arq. Elena Vázquez</span>
                    </div>
                </a>

                <!-- Enlaces Desktop -->
                <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-stone-700">
                    <a href="#inicio" class="hover:text-terracotta-500 transition-colors py-2">Inicio</a>
                    <a href="#semblanza" class="hover:text-terracotta-500 transition-colors py-2">Semblanza & Influencia</a>
                    <a href="#proyectos" class="hover:text-terracotta-500 transition-colors py-2">Catálogo de Proyectos</a>
                    <a href="#proceso" class="hover:text-terracotta-500 transition-colors py-2">Metodología</a>
                    <a href="#contacto" class="px-5 py-2.5 bg-stone-900 text-stone-50 rounded-lg hover:bg-terracotta-500 transition-colors flex items-center gap-2 text-xs uppercase tracking-wider">
                        <span>Cotizar Proyecto</span>
                        <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                    </a>
                </nav>

                <!-- Botón Menú Móvil -->
                <button id="mobile-menu-btn" class="md:hidden p-2.5 rounded-lg text-stone-800 hover:bg-stone-200/60 focus:outline-none" aria-label="Abrir menú">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <!-- Menú Desplegable Móvil -->
        <div id="mobile-menu" class="hidden md:hidden bg-stone-50 border-b border-stone-200 px-6 pt-4 pb-6 space-y-3 shadow-xl">
            <a href="#inicio" class="mobile-link block py-2.5 text-base font-medium text-stone-800 border-b border-stone-200/60">Inicio</a>
            <a href="#semblanza" class="mobile-link block py-2.5 text-base font-medium text-stone-800 border-b border-stone-200/60">Semblanza e Influencia</a>
            <a href="#proyectos" class="mobile-link block py-2.5 text-base font-medium text-stone-800 border-b border-stone-200/60">Catálogo de Proyectos</a>
            <a href="#proceso" class="mobile-link block py-2.5 text-base font-medium text-stone-800 border-b border-stone-200/60">Metodología</a>
            <div class="pt-2">
                <a href="#contacto" class="mobile-link w-full py-3 bg-terracotta-500 text-white rounded-lg font-medium flex items-center justify-center gap-2 shadow-md">
                    <i data-lucide="message-Square" class="w-4 h-4"></i>
                    <span>Consulta vía WhatsApp</span>
                </a>
            </div>
        </div>
    </header>

    <!-- 1. SECCIÓN HERO / INICIO -->
    <section id="inicio" class="relative pt-28 pb-16 md:pt-36 md:pb-24 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Columna de Texto -->
                <div class="lg:col-span-7 space-y-6">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stone-200/80 text-stone-800 text-xs uppercase tracking-widest font-medium">
                        <span class="w-2 h-2 rounded-full bg-terracotta-500 animate-pulse"></span>
                        Estudio de Arquitectura Contemporánea
                    </div>

                    <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-stone-900 leading-[1.08] tracking-tight">
                        Espacios que dialogan con la <span class="italic font-normal text-terracotta-500">luz, la tierra</span> y el tiempo.
                    </h1>

                    <p class="text-stone-600 text-base sm:text-lg max-w-2xl leading-relaxed font-light">
                        En <strong class="font-medium text-stone-900">ARQUITEK</strong> transformamos ideas en obras habitables de alto valor estético y estructural. Liderado por la Arq. Elena Vázquez, creamos arquitectura honesta que respeta su contexto natural y eleva la experiencia humana.
                    </p>

                    <div class="pt-4 flex flex-col sm:flex-row gap-4">
                        <a href="#proyectos" class="px-7 py-4 bg-stone-900 text-stone-50 rounded-xl font-medium text-sm tracking-wide hover:bg-stone-800 transition-all flex items-center justify-center gap-3 shadow-lg shadow-stone-900/10">
                            <span>Explorar Catálogo</span>
                            <i data-lucide="compass" class="w-4 h-4"></i>
                        </a>
                        <a href="#contacto" class="px-7 py-4 bg-white border border-stone-300 text-stone-900 rounded-xl font-medium text-sm tracking-wide hover:border-terracotta-500 hover:text-terracotta-600 transition-all flex items-center justify-center gap-3">
                            <i data-lucide="message-circle" class="w-4 h-4 text-emerald-600"></i>
                            <span>Agendar Diagnóstico por WhatsApp</span>
                        </a>
                    </div>

                    <!-- Indicadores / Métricas -->
                    <div class="pt-8 grid grid-cols-3 gap-6 border-t border-stone-200/90 max-w-lg">
                        <div>
                            <p class="font-serif text-3xl sm:text-4xl font-semibold text-stone-900">12+</p>
                            <p class="text-xs uppercase tracking-wider text-stone-500 mt-1">Años de Trayectoria</p>
                        </div>
                        <div>
                            <p class="font-serif text-3xl sm:text-4xl font-semibold text-stone-900">48</p>
                            <p class="text-xs uppercase tracking-wider text-stone-500 mt-1">Proyectos Construidos</p>
                        </div>
                        <div>
                            <p class="font-serif text-3xl sm:text-4xl font-semibold text-stone-900">6</p>
                            <p class="text-xs uppercase tracking-wider text-stone-500 mt-1">Premios Nacionales</p>
                        </div>
                    </div>
                </div>

                <!-- Columna de Imagen Principal Arquitectónica -->
                <div class="lg:col-span-5 relative">
                    <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-stone-200 aspect-[4/5] bg-stone-200">
                        <img 
                            src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=85" 
                            alt="Casa Bruma por ARQUITEK" 
                            class="w-full h-full object-cover"
                            onerror="this.src='https://placehold.co/800x1000/292724/F9F8F6?text=ARQUITEK'"
                        >
                        <div class="absolute inset-0 bg-gradient-to-t from-stone-900/70 via-transparent to-transparent"></div>
                        
                        <!-- Etiqueta de Obra Destacada -->
                        <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-stone-900/80 backdrop-blur-md text-stone-50 border border-stone-700/60 flex items-center justify-between">
                            <div>
                                <span class="text-[10px] uppercase tracking-[0.2em] text-terracotta-500 font-semibold block">Obra Destacada 2025</span>
                                <p class="font-serif text-lg">Residencia Piedra & Agua — Valle de Bravo</p>
                            </div>
                            <button onclick="openProjectModal(1)" class="p-2.5 bg-stone-50 text-stone-900 rounded-lg hover:bg-terracotta-500 hover:text-white transition-colors" title="Ver detalles del proyecto">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Detalle técnico flotante -->
                    <div class="hidden sm:flex absolute -top-6 -left-8 bg-stone-50 p-4 rounded-xl shadow-lg border border-stone-200 items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-terracotta-500/10 text-terracotta-600 flex items-center justify-center">
                            <i data-lucide="drafting-compass" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <p class="text-xs font-semibold text-stone-900">Diseño Bioclimático</p>
                            <p class="text-[11px] text-stone-500">Certificación sustentable & pasiva</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 2. SECCIÓN SEMBLANZA E INFLUENCIA -->
    <section id="semblanza" class="py-20 md:py-28 bg-stone-100/80 border-y border-stone-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Encabezado de Sección -->
            <div class="max-w-3xl mb-16">
                <span class="text-xs uppercase tracking-[0.25em] text-terracotta-600 font-semibold block mb-2">01 / Dirección & Filosofía</span>
                <h2 class="font-serif text-4xl sm:text-5xl text-stone-900 font-normal leading-tight">
                    Semblanza Profesional & Genealogía Creativa
                </h2>
            </div>

            <!-- Biografía + Retrato de la Arquitecta -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-20">
                
                <!-- Retrato y Ficha Curricular -->
                <div class="lg:col-span-5 space-y-6">
                    <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-[4/5] bg-stone-300 border border-stone-200">
                        <img 
                            src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=900&q=80" 
                            alt="Arq. Elena Vázquez - Fundadora de ARQUITEK" 
                            class="w-full h-full object-cover"
                            onerror="this.src='https://placehold.co/700x850/292724/F9F8F6?text=Arq.+Elena+Vazquez'"
                        >
                        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-stone-900/90 via-stone-900/40 to-transparent p-6 text-white">
                            <h3 class="font-serif text-2xl font-medium">Arq. Elena Vázquez Morales</h3>
                            <p class="text-xs uppercase tracking-widest text-stone-300 mt-1">Fundadora & Directora de Taller en ARQUITEK</p>
                        </div>
                    </div>

                    <!-- Credenciales Académicas -->
                    <div class="bg-stone-50 p-6 rounded-2xl border border-stone-200/80 space-y-4">
                        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-500">Formación & Credenciales</h4>
                        <ul class="space-y-3 text-sm text-stone-700">
                            <li class="flex items-start gap-3">
                                <i data-lucide="award" class="w-4 h-4 text-terracotta-500 shrink-0 mt-1"></i>
                                <span><strong>Maestría en Arquitectura Avanzada y Paisaje</strong> — Universitat Politècnica de Catalunya (ETSAB), Barcelona.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i data-lucide="graduation-cap" class="w-4 h-4 text-terracotta-500 shrink-0 mt-1"></i>
                                <span><strong>Licenciatura en Arquitectura con Mención Honorífica</strong> — Facultad de Arquitectura, UNAM.</span>
                            </li>
                            <li class="flex items-start gap-3">
                                <i data-lucide="building-2" class="w-4 h-4 text-terracotta-500 shrink-0 mt-1"></i>
                                <span><strong>Miembro de Número</strong> — Colegio de Arquitectos y Academia Nacional de Arquitectura.</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Texto de Semblanza e Influencias -->
                <div class="lg:col-span-7 space-y-8">
                    <!-- Cita Filosófica -->
                    <blockquote class="p-6 sm:p-8 bg-stone-900 text-stone-50 rounded-2xl shadow-lg relative overflow-hidden">
                        <span class="font-serif text-8xl text-stone-700/40 absolute -top-4 left-4 select-none">“</span>
                        <p class="font-serif text-2xl sm:text-3xl italic leading-relaxed relative z-10">
                            La arquitectura no debe imponerse sobre el paisaje con estridencia; debe surgir de él con la serenidad de una roca tallada por la luz y el viento.
                        </p>
                        <footer class="mt-4 text-xs uppercase tracking-widest text-terracotta-500 font-semibold">
                            — Manifiesto de Diseño ARQUITEK
                        </footer>
                    </blockquote>

                    <!-- Narrativa Biográfica -->
                    <div class="space-y-4 text-stone-700 leading-relaxed text-base">
                        <h3 class="font-serif text-3xl text-stone-900 font-medium">Semblanza</h3>
                        <p>
                            Con más de doce años proyectando y dirigiendo obras en México y Europa, la arquitecta <strong>Elena Vázquez</strong> fundó <strong>ARQUITEK</strong> en 2016 bajo la premisa de reconciliar la precisión tectónica contemporánea con la calidez artesanal de los materiales vernáculos.
                        </p>
                        <p>
                            Antes de establecer su propia firma, colaboró en talleres de renombre internacional en Ciudad de México, Oporto y Barcelona, perfeccionando una metodología donde cada proyecto se aborda desde su topografía, asoleamiento, acústica y memoria cultural. Su obra abarca desde residencias privadas en entornos boscosos y costeros hasta complejos culturales, boutiques y regeneración urbana.
                        </p>
                    </div>

                    <!-- Pilares de Influencia Arquitectónica -->
                    <div class="pt-4">
                        <h3 class="font-serif text-3xl text-stone-900 font-medium mb-2">Influencias y Referentes</h3>
                        <p class="text-sm text-stone-600 mb-6">
                            El lenguaje formal de ARQUITEK se nutre de cuatro corrientes fundamentales que convergen en cada plano y detalle constructivo:
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Influencia 1 -->
                            <div class="bg-stone-50 p-5 rounded-xl border border-stone-200 hover:border-terracotta-500 transition-colors">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs font-bold uppercase tracking-wider text-terracotta-600">Arquitectura Emocional</span>
                                    <i data-lucide="sun" class="w-4 h-4 text-stone-400"></i>
                                </div>
                                <h4 class="font-serif text-xl font-semibold text-stone-900 mb-1">Legado de Luis Barragán</h4>
                                <p class="text-xs text-stone-600 leading-relaxed">
                                    El manejo dramático de la penumbra y la luz natural indirecta, los muros de escala monumental, el murmullo del agua como centro espiritual del patio y la serenidad espacial.
                                </p>
                            </div>

                            <!-- Influencia 2 -->
                            <div class="bg-stone-50 p-5 rounded-xl border border-stone-200 hover:border-terracotta-500 transition-colors">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs font-bold uppercase tracking-wider text-terracotta-600">Atmósferas & Materia</span>
                                    <i data-lucide="layers" class="w-4 h-4 text-stone-400"></i>
                                </div>
                                <h4 class="font-serif text-xl font-semibold text-stone-900 mb-1">Fenomenología de Zumthor</h4>
                                <p class="text-xs text-stone-600 leading-relaxed">
                                    Honestidad constructiva absoluta: piedra volcánica sin artificios, concreto aparente entablillado, maderas certificadas y materiales que envejecen con dignidad.
                                </p>
                            </div>

                            <!-- Influencia 3 -->
                            <div class="bg-stone-50 p-5 rounded-xl border border-stone-200 hover:border-terracotta-500 transition-colors">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs font-bold uppercase tracking-wider text-terracotta-600">Geometría & Vacío</span>
                                    <i data-lucide="box" class="w-4 h-4 text-stone-400"></i>
                                </div>
                                <h4 class="font-serif text-xl font-semibold text-stone-900 mb-1">Minimalismo de Tadao Ando</h4>
                                <p class="text-xs text-stone-600 leading-relaxed">
                                    Pureza geométrica que enmarca fragmentos del cielo y la vegetación circundante, generando recorridos arquitectónicos contemplativos y orden estructural.
                                </p>
                            </div>

                            <!-- Influencia 4 -->
                            <div class="bg-stone-50 p-5 rounded-xl border border-stone-200 hover:border-terracotta-500 transition-colors">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-xs font-bold uppercase tracking-wider text-terracotta-600">Raíz & Sustentabilidad</span>
                                    <i data-lucide="leaf" class="w-4 h-4 text-stone-400"></i>
                                </div>
                                <h4 class="font-serif text-xl font-semibold text-stone-900 mb-1">Tradición Vernácula Mexicana</h4>
                                <p class="text-xs text-stone-600 leading-relaxed">
                                    Uso de tierras compactadas (tapial), celosías de barro artesanal para ventilación cruzada pasiva y captación pluvial integrada en el diseño arquitectónico.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>

    <!-- 3. SECCIÓN CATÁLOGO DE PROYECTOS -->
    <section id="proyectos" class="py-20 md:py-28">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Cabecera y Filtros -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
                <div>
                    <span class="text-xs uppercase tracking-[0.25em] text-terracotta-600 font-semibold block mb-2">02 / Obra Seleccionada</span>
                    <h2 class="font-serif text-4xl sm:text-5xl text-stone-900 font-normal">
                        Catálogo de Proyectos
                    </h2>
                </div>

                <!-- Botones de Filtro por Categoría -->
                <div class="flex flex-wrap gap-2" id="filter-container">
                    <button onclick="filterProjects('Todos')" class="filter-btn active px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all bg-stone-900 text-stone-50 shadow-sm" data-category="Todos">
                        Todos (8)
                    </button>
                    <button onclick="filterProjects('Residencial')" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all bg-stone-200/70 text-stone-700 hover:bg-stone-300/70" data-category="Residencial">
                        Residencial
                    </button>
                    <button onclick="filterProjects('Comercial')" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all bg-stone-200/70 text-stone-700 hover:bg-stone-300/70" data-category="Comercial">
                        Comercial
                    </button>
                    <button onclick="filterProjects('Interiorismo')" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all bg-stone-200/70 text-stone-700 hover:bg-stone-300/70" data-category="Interiorismo">
                        Interiorismo
                    </button>
                    <button onclick="filterProjects('Urbano')" class="filter-btn px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider transition-all bg-stone-200/70 text-stone-700 hover:bg-stone-300/70" data-category="Urbano">
                        Urbano
                    </button>
                </div>
            </div>

            <!-- Grid de Proyectos (Renderizado Dinámicamente con JS) -->
            <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Los proyectos se inyectan vía JavaScript -->
            </div>

        </div>
    </section>

    <!-- SECCIÓN COMPLEMENTARIA: METODOLOGÍA DE TRABAJO -->
    <section id="proceso" class="py-16 bg-stone-900 text-stone-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-14">
                <span class="text-xs uppercase tracking-[0.25em] text-terracotta-500 font-semibold block mb-2">03 / Cómo Trabajamos</span>
                <h2 class="font-serif text-3xl sm:text-4xl font-normal">Del Primer Trazo a la Entrega de Llaves</h2>
                <p class="text-stone-400 text-sm mt-2">Acompañamiento integral con certeza presupuestal y rigor técnico en cada etapa.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <div class="p-6 rounded-2xl bg-stone-800/70 border border-stone-700/70">
                    <span class="font-serif text-3xl text-terracotta-500 font-semibold">01.</span>
                    <h3 class="font-serif text-xl mt-3 mb-2 font-medium">Diagnóstico & Sitio</h3>
                    <p class="text-xs text-stone-300 leading-relaxed">Entrevista inicial, análisis topográfico, estudio de asoleamiento, normatividad y definición de programa arquitectónico.</p>
                </div>
                <div class="p-6 rounded-2xl bg-stone-800/70 border border-stone-700/70">
